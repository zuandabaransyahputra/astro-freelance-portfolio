---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import { config, portraitImage, seo, services } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** `article` for insights: adds og:type=article and the published date. */
  type?: 'website' | 'article';
  published?: string;
  /** Page-specific JSON-LD nodes, merged into the site-wide graph. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = seo.description,
  image,
  imageAlt = image ? (title ?? config.name) : `${config.name} — ${config.role.toLowerCase()}, ${config.availability.short.toLowerCase()}`,
  type = 'website',
  published,
  schema = [],
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} — ${config.name}` : seo.title;
// No trailing slash, matching internal links, the sitemap and vercel.json.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
// Pages without their own image share public/og.jpg (rendered from og/og.html by `npm run og`).
const og = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : { src: '/og.jpg' };
const ogUrl = new URL(og.src, Astro.site);
const ogHeight = image ? Math.round((1200 / image.width) * image.height) : 630;
const portrait = await getImage({ src: portraitImage.src, width: 800, format: 'jpg' });
const site = Astro.site!.toString();

const pageAnimation = {
  forwards: {
    old: { name: 'vt-out', duration: '0.35s', easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', fillMode: 'both' },
    new: { name: 'vt-in', duration: '0.6s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'vt-out', duration: '0.35s', easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', fillMode: 'both' },
    new: { name: 'vt-in', duration: '0.6s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
  },
};

const address = { '@type': 'PostalAddress', addressLocality: config.location.city, addressCountry: config.location.countryCode };
const telephone = config.whatsapp ? `+${config.whatsapp.number}` : undefined;

// One graph for the whole site: who you are, what is offered, and this page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: seo.title,
      description: seo.description,
      inLanguage: 'en',
      publisher: { '@id': `${site}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${site}#person`,
      name: config.name,
      alternateName: config.shortName,
      jobTitle: config.role,
      description: seo.description,
      url: site,
      image: new URL(portrait.src, site).toString(),
      email: `mailto:${config.email}`,
      telephone,
      address,
      knowsLanguage: config.languages.map((l) => l.code),
      knowsAbout: services.flatMap((s) => s.items),
      sameAs: config.socials.map((s) => s.href),
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}#service`,
      name: `${config.name} — Web Development`,
      url: site,
      image: new URL(portrait.src, site).toString(),
      description: seo.description,
      founder: { '@id': `${site}#person` },
      email: config.email,
      telephone,
      address,
      areaServed: 'Worldwide',
      availableLanguage: config.languages.map((l) => l.name),
      currenciesAccepted: config.currency,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Web development services',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.description },
        })),
      },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en" data-tz={config.timeZone} transition:animate={pageAnimation}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary" />
    {config.socials.map((s) => <link rel="me" href={s.href} />)}
    <meta name="theme-color" content="#f2f3f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {published && <meta property="article:author" content={config.name} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Mark the page as JS-capable before first paint so reveals never flash.
      If the motion script has not started within 2.5s, show everything.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__motionReady) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <slot name="after" />

    <script>
      import '../scripts/motion';
    </script>

    <style>
      .skip {
        position: fixed;
        left: 16px;
        top: -100px;
        z-index: 60;
        padding: 10px 16px;
        border-radius: 8px;
        background: var(--ink);
        color: var(--paper);
        text-decoration: none;
      }

      .skip:focus {
        top: 16px;
      }

      main {
        padding-top: var(--header-h);
      }
    </style>
  </body>
</html>
