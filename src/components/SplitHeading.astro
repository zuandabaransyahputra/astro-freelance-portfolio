---
/* A heading whose words rise one by one when it scrolls into view. */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
  delay?: number;
  id?: string;
  'transition:name'?: string;
}

const { text, as: Tag = 'h2', class: className, delay = 0, id } = Astro.props;
const words = text.split(' ');
---

<Tag class:list={['split', className]} id={id} style={`--d: ${delay}s`} aria-label={text}>
  {
    words.map((word, i) => (
      <>
        <span class="wm" aria-hidden="true">
          <span class="w" style={`--i: ${i}`}>
            {word}
          </span>
        </span>{' '}
      </>
    ))
  }
</Tag>
