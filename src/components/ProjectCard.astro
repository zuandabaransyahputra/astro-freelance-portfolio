---
import ProjectMedia from './ProjectMedia.astro';
import { categoryLabel, isExternal, projectHref, type Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const href = projectHref(project);
const external = isExternal(project);
---

<article
  class="card"
  data-category={project.category}
  data-reveal="scale"
  style={`--d: ${(index % 2) * 0.08}s; view-transition-name: card-${project.slug}`}
>
  <a
    href={href}
    class="card__media"
    tabindex="-1"
    aria-hidden="true"
    data-cursor={external ? 'Visit' : 'View'}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener' : undefined}
  >
    <ProjectMedia project={project} transitionName={`media-${project.slug}`} />
  </a>

  <div class="card__text">
    <div class="card__row">
      <h3 class="card__title">
        <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
          {project.title}
          {external && <span class="sr-only">(opens the live site)</span>}
        </a>
      </h3>
      <span class="card__meta">{categoryLabel(project.category)}<span aria-hidden="true">/</span>{project.year}</span>
    </div>
    <p class="card__summary">{project.summary}</p>
    <ul class="chips">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .card[hidden] {
    display: none;
  }

  .card__media {
    display: block;
    border-radius: 20px;
    text-decoration: none;
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .card__title {
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1.05;
    font-weight: 640;
    font-stretch: 125%;
    letter-spacing: -0.025em;
  }

  .card__title a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.5s var(--ease-out);
  }

  .card:hover .card__title a {
    background-size: 100% 2px;
  }

  .card__meta {
    flex: 0 0 auto;
    display: inline-flex;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
  }

  .card__summary {
    max-width: 56ch;
    font-size: 16px;
    color: var(--text-2);
    text-wrap: pretty;
  }
</style>
