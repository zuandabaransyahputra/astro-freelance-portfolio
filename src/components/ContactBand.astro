---
import Button from './Button.astro';
import Footer from './Footer.astro';
import SplitHeading from './SplitHeading.astro';
import { config } from '../data/site';

interface Props {
  title?: string;
}

const { title = 'Tell me what you’re building.' } = Astro.props;

const whatsapp = config.whatsapp ? `https://wa.me/${config.whatsapp.number}` : null;
const channels = [
  { label: 'Email', value: config.email, href: `mailto:${config.email}` },
  ...(config.whatsapp && whatsapp ? [{ label: 'WhatsApp', value: config.whatsapp.label, href: whatsapp }] : []),
  ...config.socials.map((s) => ({ label: s.label, value: s.handle, href: s.href })),
];
---

<section id="contact" class="band on-dark">
  <div class="container inner">
    <span class="status"><span class="status__dot" aria-hidden="true"></span>{config.availability.long}</span>
    <SplitHeading text={title} class="title" />

    <div class="row" data-reveal>
      <p>
        I help founders and teams ship fast, modern websites, from headless CMS builds to payments and AI-powered
        features. Tell me about your project and I’ll get back to you within {config.responseTime}.
      </p>
      <div class="ctas">
        <Button href="/contact" variant="paper">Start a project</Button>
        {
          whatsapp ? (
            <Button href={whatsapp} variant="ghost" external>Message me on WhatsApp</Button>
          ) : (
            <Button href={`mailto:${config.email}`} variant="ghost">Email me</Button>
          )
        }
      </div>
    </div>

    <dl class="channels">
      {
        channels.map((c, i) => (
          <div data-reveal style={`--d: ${i * 0.08}s`}>
            <dt>{c.label}</dt>
            <dd>
              <a href={c.href}>{c.value}</a>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {
          [0, 1].map(() => (
            <div class="marquee__group">
              <span>Let’s build something fast</span>
              <span class="dot" />
              <span>Let’s build something fast</span>
              <span class="dot" />
            </div>
          ))
        }
      </div>
    </div>

    <Footer />
  </div>
</section>

<style>
  .band {
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }

  .inner {
    padding-top: var(--section);
    padding-bottom: 40px;
  }

  .status {
    color: var(--dark-text);
  }

  .band :global(.title) {
    margin-top: 28px;
    max-width: 14ch;
    font-size: clamp(48px, 8vw, 132px);
    line-height: 0.94;
    font-weight: 660;
    font-stretch: 125%;
    letter-spacing: -0.045em;
  }

  .row {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px 64px;
  }

  .row p {
    flex: 1 1 480px;
    max-width: 58ch;
    font-size: clamp(18px, 1.4vw, 20px);
    line-height: 1.6;
    color: var(--dark-text);
    text-wrap: pretty;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  .channels {
    margin-top: clamp(64px, 7vw, 96px);
    padding-top: 32px;
    border-top: 1px solid var(--dark-rule);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 28px 40px;
  }

  dt {
    font-size: 14px;
    color: var(--dark-muted);
  }

  dd {
    margin-top: 6px;
    font-size: 17px;
    font-weight: 550;
    overflow-wrap: anywhere;
  }

  dd a {
    text-decoration: none;
  }

  dd a:hover {
    color: #fff;
  }

  .marquee {
    margin: clamp(56px, 7vw, 104px) calc(var(--gutter) * -1) clamp(32px, 4vw, 56px);
    overflow: hidden;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: band-marquee 26s linear infinite;
  }

  .marquee__group {
    display: flex;
    align-items: center;
    gap: clamp(24px, 3vw, 48px);
    padding-right: clamp(24px, 3vw, 48px);
    font-size: clamp(56px, 10vw, 168px);
    line-height: 1;
    font-weight: 660;
    font-stretch: 125%;
    letter-spacing: -0.045em;
    color: transparent;
    -webkit-text-stroke: 1px #4a5160;
    white-space: nowrap;
  }

  .dot {
    flex: 0 0 auto;
    width: 0.18em;
    height: 0.18em;
    border-radius: 50%;
    background: var(--accent);
  }

  @keyframes band-marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
