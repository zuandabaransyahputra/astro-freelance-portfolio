# Copy to .env for local development (`vercel env pull` also works). All optional.

# Production URL, overrides `url` in src/config.ts.
# SITE_URL=https://your-domain.com

# Resend API key. Without it the form falls back to opening the visitor's email app.
# RESEND_API_KEY=re_xxxxxxxx

# Sender on a domain verified in Resend. Also turns on the confirmation email to the visitor.
# CONTACT_FROM="Your Name <hello@your-domain.com>"

# Inbox that receives briefs. Defaults to `email` in src/config.ts.
# CONTACT_TO=you@your-domain.com
